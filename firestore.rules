/**
 * # Firestore Security Rules
 *
 * ## Core Philosophy
 * This ruleset enforces a role-based access control model. There are two primary roles:
 * 1.  **Admin**: Can read and write all data across the application, including managing core data like vehicles, services, settings, and user profiles.
 * 2.  **Authenticated User**: Can read shared application data (vehicles, services, service logs) and manage data they are directly responsible for (e.g., vehicle service records).
 *
 * ## Data Structure
 * The data is organized into flat, top-level collections for simplicity and query performance:
 * - `/vehicles/{vehicleId}`: Stores fleet vehicle information.
 * - `/services/{serviceId}`: Stores predefined maintenance service types.
 * - `/vehicleServices/{vehicleServiceId}`: Logs maintenance performed on vehicles.
 * - `/users/{userId}`: Stores user profiles, including their role.
 * - `/settings/{settingsId}`: A singleton collection for global app configuration.
 *
 * ## Key Security Decisions
 * - **Admin Supremacy**: Users with the 'Admin' role in their `/users/{userId}` document have privileged access to create, update, and delete critical shared data.
 * - **Authenticated Read-All**: Any signed-in user can read from the `/vehicles`, `/services`, and `/vehicleServices` collections. This simplifies client-side data fetching for displaying fleet-wide information.
 * - **User Data Privacy**: A user's own profile in `/users/{userId}` is only accessible by them or an admin. Listing all users is restricted to admins to prevent user enumeration.
 * - **Default Deny**: Access is denied by default. All permissions must be explicitly granted. Unauthenticated access is forbidden entirely.
 *
 * ## Denormalization for Authorization
 * The security model relies on the `role` field within each user's document at `/users/{userId}`. To determine if a user is an admin, a `get()` call is performed against their own user document. This is a secure and centralized way to manage permissions. All other authorization is based on document ownership (e.g., the `responsible` field in `vehicleServices`).
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    /**
     * Returns true if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Returns true if the requesting user's UID matches the provided userId.
     * This is the primary check for document ownership.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * Checks if the authenticated user has the 'Admin' role.
     * This performs a single document read to the user's own profile.
     */
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    /**
     * Checks if the user is the owner of a VehicleService record.
     * Authorization is based on the 'responsible' field in the document data.
     */
    function isResponsible(docData) {
      return isSignedIn() && request.auth.uid == docData.responsible;
    }

    /**
     * Validates that the user can create their own user profile document.
     * Enforces that the document ID matches the user's UID and the `id` field within the document also matches.
     */
    function canCreateOwnUserDoc(userId) {
      return isOwner(userId) && request.resource.data.id == userId;
    }
    
    /**
     * Validates that an existing document's critical IDs are not being changed on update.
     * This prevents re-assigning a user profile to a different user ID.
     */
    function isUserIdImmutable() {
      return request.resource.data.id == resource.data.id;
    }

    /**
     * Validates that the 'responsible' field on a VehicleService record is not changed by a non-admin.
     */
    function isResponsibleFieldImmutable() {
      return request.resource.data.responsible == resource.data.responsible;
    }

    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    /**
     * @description Controls access to vehicle data. All signed-in users can read, but only admins can write.
     * @path /vehicles/{vehicleId}
     * @allow (get) A signed-in user reads a specific vehicle's details.
     * @deny (create) A non-admin user attempts to add a new vehicle.
     * @principle Segregates read access from privileged write access using roles.
     */
    match /vehicles/{vehicleId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Controls access to service definitions. All signed-in users can read, but only admins can write.
     * @path /services/{serviceId}
     * @allow (list) A signed-in user fetches all available service types.
     * @deny (update) A non-admin user attempts to change a service's default kilometers.
     * @principle Segregates read access from privileged write access using roles.
     */
    match /services/{serviceId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Controls access to vehicle service logs. Signed-in users can read all logs. Users can create logs for themselves.
     *              Only the responsible user or an admin can modify or delete a log.
     * @path /vehicleServices/{vehicleServiceId}
     * @allow (create) A signed-in user creates a service log where they are the 'responsible' person.
     * @deny (update) A user tries to update a service log for which another user is responsible.
     * @principle Enforces document ownership for writes, with an admin override for management.
     */
    match /vehicleServices/{vehicleServiceId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (isResponsible(request.resource.data) || isAdmin());
      allow update: if resource != null && (isAdmin() || (isResponsible(resource.data) && isResponsibleFieldImmutable()));
      allow delete: if resource != null && (isAdmin() || isResponsible(resource.data));
    }

    /**
     * @description Controls access to user profiles. Users can manage their own profile. Admins can manage any profile.
     * @path /users/{userId}
     * @allow (update) A user updates their own phone number. `auth.uid` == `userId`.
     * @deny (get) A user attempts to read another user's profile data.
     * @deny (list) A non-admin user tries to list all users in the system.
     * @principle Restricts access to a user's own data tree, with an admin override.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if canCreateOwnUserDoc(userId);
      allow update: if resource != null && (isOwner(userId) || isAdmin()) && isUserIdImmutable();
      allow delete: if resource != null && (isOwner(userId) || isAdmin());
    }

    /**
     * @description Controls access to global application settings. Only admins can read or write these settings.
     * @path /settings/{settingsId}
     * @allow (get) An admin user reads the webhook configuration.
     * @deny (update) A non-admin user attempts to change notification settings.
     * @principle Restricts sensitive configuration data to privileged admin users only.
     */
    match /settings/{settingsId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}