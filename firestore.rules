/**
 * # Firestore Security Rules
 *
 * ## Core Philosophy
 * This ruleset enforces a role-based access control model. There are two primary roles:
 * 1.  **Admin**: Can read and write all data across the application, including managing core data like vehicles, services, settings, and user profiles.
 * 2.  **Authenticated User**: Can read shared application data and manage data they are directly responsible for (e.g., vehicle service records).
 *
 * ## Key Security Decisions
 * - **Public Read for Core Data**: Core application data like vehicles, services, and categories are publicly readable by anyone (`allow read: if true;`). This is essential for Server-Side Rendering (SSR) where the server fetches data without an authenticated user. Write access remains strictly controlled.
 * - **Admin Supremacy for Writes**: Users with the 'Admin' role in their `/users/{userId}` document have privileged access to create, update, and delete critical shared data. This check is performed via a `get()` call within the write rule itself to avoid circular dependencies.
 * - **User Data Privacy**: A user's own profile in `/users/{userId}` is only accessible by them or an admin. Listing all users is restricted to admins to prevent user enumeration.
 * - **Default Deny**: Access is denied by default. All permissions must be explicitly granted.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    /**
     * Returns true if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Returns true if the requesting user's UID matches the provided userId.
     * This is the primary check for document ownership.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    /**
     * Checks if the user is the owner of a VehicleService record.
     * Authorization is based on the 'responsible' field in the document data.
     */
    function isResponsible(docData) {
      return isSignedIn() && request.auth.uid == docData.responsible;
    }

    /**
     * Validates that the user can create their own user profile document.
     * Enforces that the document ID matches the user's UID and the `id` field within the document also matches.
     */
    function canCreateOwnUserDoc(userId) {
      return isOwner(userId) && request.resource.data.id == userId;
    }
    
    /**
     * Validates that an existing document's critical IDs are not being changed on update.
     * This prevents re-assigning a user profile to a different user ID.
     */
    function isUserIdImmutable() {
      return request.resource.data.id == resource.data.id;
    }

    /**
     * Validates that the 'responsible' field on a VehicleService record is not changed by a non-admin.
     */
    function isResponsibleFieldImmutable() {
      return request.resource.data.responsible == resource.data.responsible;
    }
    
    /**
     * Checks if the authenticated user has the 'Admin' role.
     * This performs a single document read to the user's own profile.
     * This should only be used inside a rule where isSignedIn() is already confirmed.
     */
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }


    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    /**
     * @description Publicly readable vehicle data. Only admins can write.
     */
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isSignedIn() && isAdmin();
    }

    /**
     * @description Publicly readable service definitions. Only admins can write.
     */
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isSignedIn() && isAdmin();
    }
    
    /**
     * @description Publicly readable category definitions. Only admins can write.
     */
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn() && isAdmin();
    }

    /**
     * @description Publicly readable vehicle service logs. Writes are restricted.
     */
    match /vehicleServices/{vehicleServiceId} {
      allow read: if true;
      allow create: if isSignedIn() && (isResponsible(request.resource.data) || isAdmin());
      allow update: if isSignedIn() && resource != null && (isAdmin() || (isResponsible(resource.data) && isResponsibleFieldImmutable()));
      allow delete: if isSignedIn() && resource != null && (isAdmin() || isResponsible(resource.data));
    }

    /**
     * @description User profiles. Read/write restricted to owner or admin. List restricted to admin.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow create: if canCreateOwnUserDoc(userId); // Allows a user to create their own doc
      allow update: if isSignedIn() && resource != null && (isOwner(userId) || isAdmin()) && isUserIdImmutable();
      allow delete: if isSignedIn() && resource != null && (isOwner(userId) || isAdmin());
    }

    /**
     * @description Global app settings. Only accessible by admins.
     */
    match /settings/{settingsId} {
      allow read, write: if isSignedIn() && isAdmin();
    }
  }
}
